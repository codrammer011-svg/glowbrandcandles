# Track the maintained Glow application, not the local WordPress installation.
/*
!/.gitignore
!/README.md
!/scripts/
!/wp-content/
/wp-content/*
!/wp-content/themes/
!/wp-content/plugins/
!/wp-content/mu-plugins/
/wp-content/themes/*
!/wp-content/themes/glow-scented-candles/
/wp-content/plugins/*
!/wp-content/plugins/glow-fundraiser-core/
!/wp-content/plugins/Fundraiser-Modules/
!/wp-content/plugins/glow-dashboard-fixes/
!/wp-content/plugins/glow-seller-email-resend/
!/wp-content/plugins/quick-orders-for-woocommerces/
!/wp-content/plugins/shiptoschool-shipping/
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/glow-*.php

# Secrets, generated data and development artifacts.
**/wp-config.php
**/.env
**/.env.*
**/*.sql
**/*.sql.*
**/*.log
**/error_log
**/*.bak*
**/*.php-*
**/*.js-*
**/*.css-*
**/*-backup*
**/*.backup*
**/*.bk
**/*.bk-*
**/*.zip
**/*.tar
**/*.tar.gz
**/*.7z
**/node_modules/
**/.DS_Store
**/Thumbs.db
**/*-temp.php
**/*.deploy-tmp
