function getSellerOrderCalculation() {
    
    jQuery('.fundraiser-order-details-table').each(function(){
    var frOrderSubtotal = 0;
    var frOrderTotal = jQuery(".fr-footer .product-price span", this).html();
    jQuery('.fr-body.line-item-match .product-price span', this).each(function(){
    frOrderSubtotal += parseFloat(jQuery(this).text());  // Or this.innerHTML, this.innerText
    });
       var frDiscount = frOrderSubtotal-frOrderTotal;
        jQuery(".fr-footer .all-order-subtotal span", this).html(frOrderSubtotal.toFixed(2));
        jQuery(".fr-footer .all-order-discount span", this).html(frDiscount.toFixed(2));
    //    console.log(frOrderSubtotal);
    //    console.log(frOrderTotal);
    //    console.log(frDiscount);

    });
    
    
    
    
    jQuery('.page-template-fundraiser-seller-reports .online-sale .fundraiser-order-row.sellermatch').each(function(){
    var sellerOrderSubTotal = 0;
    jQuery('.fundraiser-order-details-col.product-price.show span', this).each(function(){
    sellerOrderSubTotal += parseFloat(jQuery(this).text());  // Or this.innerHTML, this.innerText
    });
    
    jQuery(".fundraiser-order-details-col.seller-order-subtotal span", this).html(sellerOrderSubTotal.toFixed(2));
    jQuery(".fundraiser-order-details-col.seller-order-discount span", this).html("0");
    jQuery(".fr-footer .fundraiser-order-details-col.product-price span", this).html(sellerOrderSubTotal.toFixed(2));
    jQuery("span.fr-order-amt", this).html(sellerOrderSubTotal.toFixed(2));
    }); 
    
    jQuery('.page-template-fundraiser-seller-reports .catalogue-sale .fundraiser-order-row.itemmatch, .page-template-seller-dashboard .catalogue-sale .fundraiser-order-row.itemmatch').each(function(){
        var thisOrderQty = parseFloat(jQuery(".parent-order-qty span", this).text());;
        if (thisOrderQty > 99) {
            var totalOrderAmt = jQuery(".fr-footer .all-order-subtotal span", this).html();
            var orderDiscountCalc = totalOrderAmt*5/10;
            var discountedOrderAmt = totalOrderAmt - orderDiscountCalc;
        jQuery(".fr-footer .all-order-discount-calc span", this).html(orderDiscountCalc.toFixed(2));
        jQuery(".fr-footer .product-price span", this).html(discountedOrderAmt.toFixed(2));
        } else {
            var totalOrderAmt = jQuery(".fr-footer .all-order-subtotal span", this).html();
            var orderDiscountCalc = totalOrderAmt*4/10;
            var discountedOrderAmt = totalOrderAmt - orderDiscountCalc;
        jQuery(".fr-footer .all-order-discount-calc span", this).html(orderDiscountCalc.toFixed(2));
        jQuery(".fr-footer .product-price span", this).html(discountedOrderAmt.toFixed(2));
        jQuery("span.fr-order-amt", this).html(discountedOrderAmt.toFixed(2));
        }
    });
    
    
} 
