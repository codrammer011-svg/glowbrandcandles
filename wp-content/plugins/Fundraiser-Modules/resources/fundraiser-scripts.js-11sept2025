jQuery(".page-template-admin-reports span.filter_dates").click(function() {
    var fromDate = parseInt(jQuery("#from_date").val().replace(/[^a-z0-9\s]/gi, ''))-1;
    var toDate = parseInt(jQuery("#to_date").val().replace(/[^a-z0-9\s]/gi, ''))+1;
    jQuery('.page-template-admin-reports .fundraiser-order-row.fr-body').each(function(){
        jQuery(this).removeClass("datematch nodatematch");
        var orderDate = parseInt(jQuery(".fr-order-date", this).html().replace(/[^a-z0-9\s]/gi, ''));
        if (fromDate < orderDate && orderDate < toDate) {
            jQuery(this).removeClass("nodatematch");
            jQuery(this).addClass("datematch");
        } else {
            jQuery(this).removeClass("datematch");
            jQuery(this).addClass("nodatematch");            
        }
                
    });
    adminCalculations();
});

